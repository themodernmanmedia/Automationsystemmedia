# ============================================================================
# THE MODERN MAN OS — environment configuration
# Copy to .env and fill in. The app refuses to boot with placeholder secrets.
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# REQUIRED — core infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://mmos:mmos@localhost:5432/mmos?schema=public
REDIS_URL=redis://localhost:6379

# Generate both with: openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# REQUIRED for Instagram publishing — S3-compatible object storage
# Meta FETCHES media from a public URL; it does not accept uploaded bytes.
# Without publicly-resolvable storage, Instagram publishing cannot work.
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO.
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# AI PROVIDERS — at least one LLM provider is required
# ---------------------------------------------------------------------------
# Two model tiers. The quality model writes everything that gets published and
# runs every safety gate; the fast model handles the high-volume ranking passes
# (trend scanning and topic scoring), where the work is classification rather
# than writing and the strongest model would cost more without changing the
# outcome. Leaving the fast model unset makes everything use the quality one.
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# Optional media providers. Unset providers throw ProviderNotConfiguredError
# at call time — they never return fake media.
IMAGE_PROVIDER=                   # openai | stability | none
VOICE_PROVIDER=                   # elevenlabs | openai | none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
STABILITY_API_KEY=

# Licensed stock photography, used when generation is unavailable or you prefer
# real imagery. Both licence for commercial use, and both API terms require
# crediting the photographer — the system adds that credit to the caption
# automatically, and refuses to publish an asset whose attribution is missing.
# Optional: without either, slides render on the brand background.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# RESEARCH / TREND SOURCES
# There is NO legitimate commercial trend API from IG/TikTok/FB (see
# docs/API_LIMITATIONS.md §5). Trend discovery uses these instead.
# RSS requires no key and works out of the box.
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=                  # brave | tavily | none
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
NEWSAPI_KEY=
RSS_FEEDS=https://feeds.bbci.co.uk/news/business/rss.xml,https://techcrunch.com/feed/

# ---------------------------------------------------------------------------
# META (Instagram + Facebook) — one app covers both
# developers.facebook.com → create app → Business type
# Required IG scopes: instagram_business_basic, instagram_business_content_publish,
#                     instagram_business_manage_insights
# Required FB scopes:  pages_show_list, pages_manage_posts, pages_read_engagement,
#                      read_insights
# Requires: IG Professional account linked to a Facebook Page + App Review.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_REDIRECT_URI=http://localhost:4000/api/oauth/meta/callback

# ---------------------------------------------------------------------------
# TIKTOK — developers.tiktok.com
# Scopes: user.info.basic, user.info.stats, video.publish, video.upload, video.list
# WARNING: until your client passes TikTok audit, ALL posts are forced to
# SELF_ONLY (private). See docs/API_LIMITATIONS.md §1.
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/api/oauth/tiktok/callback

# ---------------------------------------------------------------------------
# MEDIA RENDERING — required for Reel production
# ---------------------------------------------------------------------------
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
RENDER_WORK_DIR=./tmp/renders

# ---------------------------------------------------------------------------
# AUTOMATION + COST GUARDRAILS
# ---------------------------------------------------------------------------
AUTONOMOUS_MODE=false             # master switch; start false
DAILY_COST_LIMIT_USD=25
MONTHLY_COST_LIMIT_USD=500
MAX_POSTS_PER_DAY=8
QUEUE_TARGET_HOURS=72
QUEUE_MIN_HOURS=24
QUEUE_MAX_HOURS=168
