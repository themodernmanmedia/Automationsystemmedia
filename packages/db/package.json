{
  "name": "@mmos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/with-env.mjs generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/with-env.mjs generate",
    "migrate": "node scripts/with-env.mjs migrate deploy",
    "migrate:dev": "node scripts/with-env.mjs migrate dev",
    "push": "node scripts/with-env.mjs db push",
    "seed": "tsx src/seed.ts",
    "studio": "node scripts/with-env.mjs studio"
  },
  "dependencies": {
    "@mmos/core": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2"
  }
}
